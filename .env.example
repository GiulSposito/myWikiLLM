# Copy this file to .env and fill in the values.
# .env is gitignored — never commit it.

# Required when provider: anthropic (direct Anthropic API)
ANTHROPIC_API_KEY=

# Required when using a LiteLLM proxy or ANTHROPIC_BASE_URL redirect
ANTHROPIC_BASE_URL=

# Optional: bearer token for proxies that require authentication
ANTHROPIC_AUTH_TOKEN=
